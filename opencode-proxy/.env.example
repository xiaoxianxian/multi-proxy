# OpenCode Proxy 环境变量配置
# 使用方法：复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# 代理端口 (默认: 18798)
PORT=18798

# ============================================
# 上游模型 API Key — 按需配置，不用的留空即可
# ============================================

# DeepSeek API Key
# 申请地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Moonshot/Kimi API Key
# 申请地址: https://platform.moonshot.cn
MOONSHOT_API_KEY=

# Agnes AI API Key
# 申请地址: https://agnes-ai.com
AGNES_API_KEY=

# ============================================
# opencode 接入（客户端侧配置）
#   在 opencode 的 provider 配置里把 baseURL 指向本代理：
#     baseURL = http://127.0.0.1:18798/v1
#   opencode 直接写上游真实模型名（如 deepseek-v4-pro），本代理透传转发
# ============================================
