# Generic OpenAI-Compatible Proxy 环境变量配置
# 使用方法：复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# 代理端口 (默认: 18799)
PORT=18799

# ============================================
# 上游模型 API Key — 按需配置，不用的留空即可
# ============================================

# DeepSeek API Key
# 申请地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Moonshot/Kimi API Key
# 申请地址: https://platform.moonshot.cn
MOONSHOT_API_KEY=

# Agnes AI API Key
# 申请地址: https://agnes-ai.com
AGNES_API_KEY=

# ============================================
# 客户端接入（三家共用本网关，配置方式完全一致）
#   三家都是 OpenAI 兼容客户端：把 base_url 指向本代理、api_key 随便填、model 写上游真实模型名。
#   本代理透传转发，按模型名路由到对应上游，并记录成本台账。
#   端口统一 18799，base_url 统一 http://127.0.0.1:18799/v1
# ============================================
#
# --- Cline (VS Code 扩展) ---
#   settings.json:
#   {
#     "cline.apiConfiguration": {
#       "apiProvider": "openai",
#       "openaiBaseUrl": "http://127.0.0.1:18799/v1",
#       "openaiApiKey": "any-non-empty",
#       "openaiModelId": "deepseek-v4-pro"
#     }
#   }
#
# --- Aider (CLI) ---
#   aider --openai-api-base http://127.0.0.1:18799/v1 \
#         --openai-api-key any-non-empty \
#         --model deepseek/deepseek-v4-pro
#   或环境变量：OPENAI_API_BASE / OPENAI_API_KEY / OPENAI_API_MODEL
#
# --- OpenHands (原 OpenDevin) ---
#   config.toml:
#   [llm]
#   model = "deepseek-v4-pro"
#   base_url = "http://127.0.0.1:18799/v1"
#   api_key = "any-non-empty"
#
# 注：想让成本台账按客户端归因，可在请求头带 x-agent: cline|aider|openhands；
#     不带也能跑，默认记成 generic-openai-proxy。UA 含 cline/aider/openhands 也会自动识别。
