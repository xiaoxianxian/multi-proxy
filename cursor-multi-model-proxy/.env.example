# Cursor Multi-Model Proxy 环境变量配置
# 使用方法：复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# 代理端口 (默认: 18794)
PORT=18794

# ============================================
# Admin API 认证 (P0-4)
# ============================================
# 设置后 /admin-api/* 必须携带 x-proxy-auth: <token> 请求头。
# Manager 转发时会自动透传 PROXY_AUTH_TOKEN。留空则不启用认证
# （仅建议纯本机使用时留空）。
PROXY_AUTH_TOKEN=

# CORS 允许的来源（逗号分隔）。留空 = 仅同源访问（推荐），
# 例如从其它地址的管理页面访问时：CORS_ORIGIN=http://192.168.1.10:18792
CORS_ORIGIN=

# ============================================
# 加密密钥 — 用于保护存储在 SQLite 中的 API Key
# ============================================
# 选项 1（推荐）：留空不填，系统会自动生成一个随机密钥
#   密钥会保存在 .encryption-key 文件中
ENCRYPTION_KEY=

# 选项 2：设置自定义密钥（至少 32 个字符以获得最大安全性）
# ENCRYPTION_KEY=your-custom-key-at-least-32-characters-long

# 注意：如果更换了 ENCRYPTION_KEY，之前加密存储的 API Key 将无法解密
