# opencode-free 插件配置（复制成本目录 .env 后按需填；server.mjs 启动时读，改了要 launchd.sh restart）

# 本地监听端口（避开 18793-18799 multi-proxy 管理段）
OPENCODE_FREE_PORT=18800

# 上游：opencode 改了端点只改这里
OPENCODE_UPSTREAM=https://opencode.ai/inference/v1

# 本机代理（Clash/SSR 7897）；置空则直连 opencode.ai
OPENCODE_PROXY=http://127.0.0.1:7897

# 默认 public：仅能列目录 + 形态转发。
# 填真实 opencode 账号 key 后：付费模型可调通、免费模型在登录态下一般也通（绕过 FreeTierError 会话门）。
# 注意：此 key 只进 .env，绝不落 plist 明文。
OPENCODE_API_KEY=public

# 流式无数据收尾时限（毫秒），防 kimi 卡 180s
OPENCODE_STREAM_IDLE_MS=60000

# 偶发 400 重试（换新 opencode session）：1 开 / 0 关
OPENCODE_RETRY_400=1
