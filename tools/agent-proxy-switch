#!/usr/bin/env bash
#
# agent-proxy-switch — 各 AI agent 的「模型代理所有权」安全切换器
# =====================================================================
# 作用：
#   在 proxy-rebuild 与「另一候选」之间，安全切换某个 agent 的模型代理
#   base_url。支持 codex / hermes / cursor 三个 agent。
#
# 为什么需要它（一次真实事故总结）：
#   本机曾同时有 cc-switch 与 proxy-rebuild 两套代理工具。若两者同时
#   把同一个 agent 的 base_url 指向自己，就会“打架”。本工具用一条铁律
#   规避：同一时刻，一个 agent 的 base_url 只能有一个值 → 结构上不可能
#   被两个工具同时拥有（不需要额外加锁）。
#
# 设计原则（务必遵守，写代码改本项目时同理）：
#   1. 单一所有者：每 agent 的 base_url 同一时刻只能指向一个代理。
#   2. 绝不污染全局环境：本工具只改各 agent 自己的配置文件里的 base_url，
#      绝不使用 `launchctl setenv NO_PROXY/no_proxy ...`。历史上某次往
#      launchd 注入了含裸 `*` 的 NO_PROXY，导致所有走系统代理环境变量
#      的 GUI 应用（WorkBuddy、CC Switch 的 outbound 等）把“所有域名”都
#      判定为不走代理，直连被墙 IP → ETIMEDOUT，把全系统带崩。
#      （原理：HTTP 客户端对 NO_PROXY 按逗号拆项做 hostname.endsWith(项)；
#       `*` 去前导通配符后变空串 → endsWith('') 恒真 → 全部绕过代理。）
#       ★ 任何代码都禁止写裸 `*`；如确需绕过 localhost，只在该代理自身
#         plist 的 <EnvironmentVariables> 里设 NO_PROXY=127.0.0.1,localhost,::1。
#   3. 不误伤其它 agent：切 codex 只动 codex 的 config；切 hermes 只动
#      hermes 的 config；互不干扰。也不管理任何代理进程的生命周期
#      （启停由 install.sh / manage.sh / 用户自己负责）。
#   4. 不死链：切到某个代理前，先确认它真的在监听对应端口；否则拒绝写入，
#      避免把 base_url 指向一个已死/未启动的端口导致 agent 断连。
#
# 用法：
#   agent-proxy-switch                  # 查看全部 agent 的当前所有者 + 端口状态
#   agent-proxy-switch <agent>          # 查看单个 agent 的状态
#   agent-proxy-switch <agent> <owner>  # 把 agent 的代理切到 owner
#
#   <agent> ∈ codex | hermes | cursor | dsh
#   <owner> 取决于 agent：
#     codex  : cc-switch | proxy-rebuild | curator | off
#     hermes : proxy-rebuild | direct    | curator | off
#     cursor : proxy-rebuild | direct    | curator | off   （GUI 里，半自动）
#     dsh    : direct                    | curator | off   （dsh 无「直连」，closest 是官方 baseURL）
#
# 🔴 curator / off 是 2026-10-02 加的「省钱总开关」一对：
#   curator = 把该 agent 的 base_url 指到 token-policy-bridge（18795），走 curator pack
#             （history 折叠 / tool-output 裁剪 / tools lazyload）真省钱。
#   off     = 回滚到「切 curator 之前」的那个 owner（状态记在 state 文件里）。
#             不是猜「直连是谁」，而是 undo —— codex 的原生直连是 api.openai.com，
#             本工具不知情，猜错就会把 agent 送到一个没账本的地方。
#   ⇒ 未激活 curator 时对 agent 零打扰：桥可以常在，但 host 的 base_url 不动。
#   ⚠️ 关掉 curator 不等于关掉桥；要彻底静默请 `tools/bridge-launchd.sh stop`。
#
# 给 dsh 接的注意点（实测自 ~/.dsh/profiles/desktop/cordis.patch.yml）：
#   dsh 是「provider 注册表」型客户端，端点写在
#   `- id: llm-pi-ai / config: providers: <名字>: { api, baseURL, apiKeyEnv, models }`。
#   patch 是 id-targeted 合并（2026-10-02 读 dsh 内置包确认：deepseek / pi-ai /
#   api-key / account 是四个独立 entry），所以加一条 provider 不会把 deepseek 干掉。
#   ⚠️ 但 provider 里的 `models:` 是显式白名单，只改 baseURL 不够 —— 模型不列进去，
#      dsh 的上下文里就选不到它。用 dsh 请一并补 models。
#
set -eo pipefail

# ---- 端口（务必与 install.sh 保持一致）----
CODEX_PORT=18790
HERMES_PORT=18793
CURSOR_PORT=18794
CC_SWITCH_PORT=15721

# ---- curator（token-policy-bridge，2026-10-02 加）----
# 🔴 端口冲突已解（2026-10-02 维护者点头）：CURSOR_PORT 一直是 18794（manage.sh:26，产品既定），
#    所以把 **桥挪到 18795**，cursor 的 18794 一个字节不动。
#    ⚠️ 改端口必须动三处并重启：tools/token-policy-bridge.js 默认值、tools/token-policy-bridge.plist、
#       ~/Library/LaunchAgents/com.multi-proxy.token-policy-bridge.plist，然后 bridge-launchd.sh restart。
CURATOR_PORT=18795
CURATOR_URL="http://127.0.0.1:18795/v1"
# dsh：provider 注册表里的目标 provider 名（可用 DSH_PROVIDER= 覆盖）
DSH_PROVIDER="${DSH_PROVIDER:-agnes}"
# 🔴 dsh 切 curator 时默认模型的落点：维护者要验的是「dsh + DeepSeek 自家模型」，
#    所以默认给 deepseek-v4-flash（该名字必须已在 curator provider 的 models 白名单里）。
DSH_CURATOR_MODEL="${DSH_CURATOR_MODEL:-deepseek-v4-flash}"
DSH_CFG="${DSH_PROFILE:-$HOME/.dsh/profiles/desktop}/cordis.patch.yml"
# curator/off 的切换状态（off = undo 到这条记录的上一个 owner）
SWITCH_STATE="${SWITCH_STATE:-$HOME/.multi-proxy-manager/curator-switch-state.json}"

# ---- 各 owner 的目标 URL ----
CC_SWITCH_URL="http://127.0.0.1:15721/v1"
PR_CODEX_URL="http://127.0.0.1:18790/v1"
PR_HERMES_URL="http://127.0.0.1:18793/v1"
PR_CURSOR_URL="http://127.0.0.1:18794/v1"
DIRECT_HERMES_URL="https://apihub.agnes-ai.com/v1"

# ---- 配置文件 ----
CODEX_CFG="$HOME/.codex/config.toml"
HERMES_CFG="$HOME/.hermes/config.yaml"

port_listening() {
  /usr/sbin/lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

# ---- 读取当前 base_url ----
# 🔴 2026-10-02 修：section 名写死 `[model_providers.custom]` 会读不到值。
#    实测本机 codex 的 section 叫 `[model_providers.bridge]`（19:32 被另一个进程
#    改过：model=deepseek-v4-flash / model_provider=bridge / base_url=:18799）。
#    ⇒ 改成通用匹配任意 `model_providers.*` 子节，子节名变化不再读不出。
# 🔴 另：调用方 `local url; url="$(...)"` 在 set -e 下，若这里返回非 0 会
#    静默杀掉整个 status 输出（表现为「只打了个标题就退出」）。故加 `|| true`。
current_codex_url() {
  grep -A20 '\[model_providers\.[^]]*\]' "$CODEX_CFG" 2>/dev/null \
    | grep -E '^[[:space:]]*base_url' | head -1 \
    | sed -E 's/.*=[[:space:]]*"([^"]+)".*/\1/' || true
}
current_hermes_url() {
  # 取顶层 model: 块内的 2 空格缩进 base_url。
  # 不能直接 grep '^  base_url:' —— 新版 config.yaml 里 delegation、
  # auxiliary 等其它顶层块也有 2 空格缩进的 base_url（且常为空值），
  # 排在 model 块前面会被误读，导致所有者误判 unknown。
  # 注意 ^model: 不会匹配 model_catalog:（冒号位置不同）。
  awk '
    /^[A-Za-z_][A-Za-z0-9_]*:/ { in_model = ($0 ~ /^model:[[:space:]]*$/) }
    in_model && /^  base_url:/ {
      sub(/^  base_url:[[:space:]]*/, "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "$HERMES_CFG" 2>/dev/null
}

# ---- 写入 base_url ----
set_codex() {
  local new_url="${1:-}"
  [ -z "$new_url" ] && { echo "  内部错误：未提供目标 URL" >&2; return 1; }
  local cur; cur="$(current_codex_url)"
  [ "$cur" = "$new_url" ] && { echo "  当前 base_url 已是 $new_url，无需改动。"; return 0; }
  cp "$CODEX_CFG" "$CODEX_CFG.bak.$(date +%Y%m%d-%H%M%S)"
  NEW_URL="$new_url" python3 - "$CODEX_CFG" <<'PY'
import sys, re, os
path = sys.argv[1]; new_url = os.environ['NEW_URL']
lines = open(path).read().split('\n')
in_sec = False; replaced = False
for i, line in enumerate(lines):
    if re.match(r'^\s*\[model_providers\.[^]]*\]\s*$', line):
        in_sec = True; continue
    if in_sec and re.match(r'^\s*\[', line):
        in_sec = False
    if in_sec and re.match(r'^\s*base_url\s*=', line):
        lines[i] = f'base_url = "{new_url}"'; replaced = True
open(path, 'w').write('\n'.join(lines))
if not replaced:
    raise SystemExit("未在 [model_providers.custom] 找到 base_url，未修改：" + path)
PY
  echo "  已写入 base_url = $new_url"
}

set_hermes() {
  local new_url="${1:-}"
  [ -z "$new_url" ] && { echo "  内部错误：未提供目标 URL" >&2; return 1; }
  local cur; cur="$(current_hermes_url)"
  [ "$cur" = "$new_url" ] && { echo "  当前 model.base_url 已是 $new_url，无需改动。"; return 0; }
  cp "$HERMES_CFG" "$HERMES_CFG.bak.$(date +%Y%m%d-%H%M%S)"
  NEW_URL="$new_url" python3 - "$HERMES_CFG" <<'PY'
import sys, re, os
path = sys.argv[1]; new_url = os.environ['NEW_URL']
lines = open(path).read().split('\n')
section = None      # 当前顶层 section 名
in_custom = False   # 是否在 providers.custom 内
rep_model = False
rep_custom = False
for i, line in enumerate(lines):
    m = re.match(r'^([A-Za-z_][A-Za-z0-9_]*):', line)
    if m and line[:1] not in ' \t':
        section = m.group(1); in_custom = False; continue
    if section == 'model' and re.match(r'^  base_url:', line):
        lines[i] = f'  base_url: {new_url}'; rep_model = True
    if section == 'providers' and re.match(r'^  custom:', line):
        in_custom = True; continue
    if in_custom and re.match(r'^    base_url:', line):
        lines[i] = f'    base_url: {new_url}'; rep_custom = True
    if in_custom and re.match(r'^  [A-Za-z_]', line):
        in_custom = False
open(path, 'w').write('\n'.join(lines))
if not (rep_model and rep_custom):
    raise SystemExit(f"未同时找到 model.base_url 与 providers.custom.base_url，未修改：{path}")
PY
  echo "  已写入 model.base_url 与 providers.custom.base_url = $new_url"
}

# ---- dsh：读 / 写 cordis.patch.yml 里 llm-pi-ai.provider 的 baseURL ----
# 结构（实测 ~/.dsh/profiles/desktop/cordis.patch.yml）：
#   - id: llm-pi-ai
#     name: "@deepseek-ai/dsh-llm-pi-ai"
#     config:
#       providers:
#         agnes:                       ← DSH_PROVIDER（默认 agnes）
#           apiKeyEnv: AGNES_API_KEY
#           api: openai-completions
#           baseURL: https://apihub.agnes-ai.cn/v1   ← 我们动这一行
#           models:
dsh_patch_scan() {
  DSH_PATH="$DSH_CFG" DSH_PROV="$DSH_PROVIDER" DSH_MODE="$1" python3 - <<'PY'
import os, re, sys
path = os.environ['DSH_PATH']; prov = os.environ['DSH_PROV']; mode = os.environ['DSH_MODE']
try:
    lines = open(path).read().split('\n')
except OSError as e:
    sys.stderr.write("无法读取 %s：%s\n" % (path, e)); sys.exit(3)

in_llm = False; in_prov = False; idx = -1; val = ''
for i, line in enumerate(lines):
    if not in_llm:
        if re.match(r'^\s*-\s*id:\s*llm-pi-ai\s*$', line):
            in_llm = True
        continue
    if re.match(r'^\s*-\s*id:\s*', line):
        break                                  # 下一个 entry，停
    if not in_prov and re.match(r'^\s*providers:\s*$', line):
        in_prov = True
        continue
    if in_prov:
        if re.match(r'^\S', line):
            break                              # 顶层新键，超出 providers 块
        m = re.match(r'^(\s*)(' + re.escape(prov) + r'):\s*$', line)
        if not m:
            continue
        ind = len(m.group(1))
        j = i + 1
        while j < len(lines):
            nl = lines[j]
            if nl.strip() and (len(nl) - len(nl.lstrip(' '))) <= ind:
                break                          # 该 provider 块结束
            m2 = re.match(r'^(\s*)baseURL:\s*(.*?)\s*$', nl)
            if m2 and len(m2.group(1)) > ind:
                idx = j
                val = m2.group(2).strip()
                break
            j += 1
        break

if mode == 'read':
    if idx < 0:
        sys.stderr.write("未在 llm-pi-ai.providers.%s 下找到 baseURL\n" % prov); sys.exit(4)
    print(val)
    sys.exit(0)

if mode == 'write' and idx >= 0:
    url = os.environ['DSH_URL']
    quoted = '"%s"' % url if '"' in val else url
    lines[idx] = re.sub(r'^(.*baseURL:\s*).*$', lambda mm: mm.group(1) + quoted, lines[idx])
    open(path, 'w').write('\n'.join(lines))
    print("  已写入 providers.%s.baseURL = %s" % (prov, quoted))
    sys.exit(0)

if mode == 'readdefault':
    start = -1
    for i, line in enumerate(lines):
        if re.match(r'^\s*-\s*id:\s*agent-default-model\s*$', line):
            start = i; break
    if start < 0:
        sys.stderr.write("未找到 agent-default-model entry\n"); sys.exit(4)
    pv = mv = ''
    for j in range(start, min(start + 12, len(lines))):
        m = re.match(r'^\s*provider:\s*(.*?)\s*$', lines[j])
        if m and not pv: pv = m.group(1)
        m2 = re.match(r'^\s*model:\s*(.*?)\s*$', lines[j])
        if m2 and not mv: mv = m2.group(1)
    print('%s|%s' % (pv, mv)); sys.exit(0)

if mode == 'default':
    prov_new = os.environ['DSH_DEFAULT_PROV']; model_new = os.environ['DSH_DEFAULT_MODEL']
    start = -1
    for i, line in enumerate(lines):
        if re.match(r'^\s*-\s*id:\s*agent-default-model\s*$', line):
            start = i; break
    if start < 0:
        sys.stderr.write("未找到 agent-default-model entry\n"); sys.exit(4)
    hp = hm = False
    for j in range(start, min(start + 12, len(lines))):
        m = re.match(r'^(\s*provider:\s*).*$', lines[j])
        if m and not hp: lines[j] = m.group(1) + prov_new; hp = True
        m2 = re.match(r'^(\s*model:\s*).*$', lines[j])
        if m2 and not hm: lines[j] = m2.group(1) + model_new; hm = True
        if hp and hm: break
    if not (hp and hm):
        sys.stderr.write("agent-default-model 下没找到 provider/model 行\n"); sys.exit(4)
    open(path, 'w').write('\n'.join(lines))
    print("  已写入 agent-default-model -> provider=%s model=%s" % (prov_new, model_new))
    sys.exit(0)

sys.stderr.write("未在 llm-pi-ai.providers.%s 下找到 baseURL，未修改：%s\n" % (prov, path)); sys.exit(4)
PY
}
current_dsh_url() { dsh_patch_scan read; }
# dsh 的开关是「换默认 provider」而不是改 baseURL：curator provider 的 baseURL 本来就是桥，
# 所以 curator/off 只动 agent-default-model 这一个 entry 的 provider（+ model）字段。
dsh_default_model() {
  DSH_PATH="$DSH_CFG" python3 - <<'PY'
import os, re, sys
path = os.environ['DSH_PATH']
try: lines = open(path).read().split('\n')
except OSError as e:
    sys.stderr.write("读取失败：%s\n" % e); sys.exit(3)
start = -1
for i, line in enumerate(lines):
    if re.match(r'^\s*-\s*id:\s*agent-default-model\s*$', line):
        start = i; break
if start < 0:
    sys.stderr.write("未找到 agent-default-model\n"); sys.exit(4)
pv = mv = ''
for j in range(start, min(start + 12, len(lines))):
    m = re.match(r'^\s*provider:\s*(.*?)\s*$', lines[j])
    if m and not pv: pv = m.group(1)
    m2 = re.match(r'^\s*model:\s*(.*?)\s*$', lines[j])
    if m2 and not mv: mv = m2.group(1)
print('%s|%s' % (pv, mv))
PY
}
set_dsh_default() {
  [ -n "$1" ] && [ -n "$2" ] || { echo "  内部错误：dsh 默认模型需要 provider+model" >&2; return 1; }
  cp "$DSH_CFG" "$DSH_CFG.bak.$(date +%Y%m%d-%H%M%S)"
  DSH_DEFAULT_PROV="$1" DSH_DEFAULT_MODEL="$2" dsh_patch_scan default
}
set_dsh() {
  local new_url="${1:-}"
  [ -z "$new_url" ] && { echo "  内部错误：未提供目标 URL" >&2; return 1; }
  cp "$DSH_CFG" "$DSH_CFG.bak.$(date +%Y%m%d-%H%M%S)"
  DSH_URL="$new_url" dsh_patch_scan write
}

# ---- 切换状态：curator → 记住上一个 owner，off → undo ----
# $1=agent  $2=切前 owner 名  $3=切前实际 URL（off 靠它还原，光有 owner 名不够）
record_switch() {
  mkdir -p "$(dirname "$SWITCH_STATE")"
  cat > "$SWITCH_STATE" <<EOF
{"agent":"$1","from":"$2","fromUrl":"$3","fromModel":"$4","to":"curator","at":"$(date -u +%Y-%m-%dT%H:%M:%SZ)"}
EOF
}
# 输出格式 "agent|from|fromUrl|fromModel"（dsh 靠 fromModel 精确回滚到切前的 model）
last_switch() {
  [ -f "$SWITCH_STATE" ] || return 1
  /usr/bin/python3 -c "
import json,sys
d=json.load(open(sys.argv[1]))
print('%s|%s|%s|%s|%s' % (d.get('agent',''), d.get('from',''), d.get('fromUrl',''), d.get('fromModel',''), d.get('fromProv','')))
" "$SWITCH_STATE" 2>/dev/null
}

# ---- 识别当前所有者 ----
detect_owner() {
  local agent="$1" url="$2"
  case "$agent" in
    codex)
      [ "$url" = "$CC_SWITCH_URL" ] && { echo cc-switch; return; }
      [ "$url" = "$CURATOR_URL" ] && { echo curator; return; }
      [ "$url" = "$PR_CODEX_URL" ] && { echo proxy-rebuild; return; } ;;
    hermes)
      [ "$url" = "$CURATOR_URL" ] && { echo curator; return; }
      [ "$url" = "$PR_HERMES_URL" ] && { echo proxy-rebuild; return; }
      [ "$url" = "$DIRECT_HERMES_URL" ] && { echo direct; return; } ;;
    dsh)
      [ "$url" = "$CURATOR_URL" ] && { echo curator; return; }
      [ -n "$url" ] && { echo direct; return; } ;;
  esac
  echo "unknown ($url)"
}

status_one() {
  local agent="$1"
  case "$agent" in
    codex)
      local url; url="$(current_codex_url)"
      echo "Codex:"
      echo "  当前所有者            = $(detect_owner codex "$url")"
      echo "  base_url              = ${url:-（未读取到）}"
      echo "  cc-switch(15721) 监听 = $(port_listening $CC_SWITCH_PORT && echo 是 || echo 否)"
      echo "  proxy-rebuild(18790) 监听 = $(port_listening $CODEX_PORT && echo 是 || echo 否)" ;;
    hermes)
      local url; url="$(current_hermes_url)"
      echo "Hermes:"
      echo "  当前所有者            = $(detect_owner hermes "$url")"
      echo "  model.base_url        = ${url:-（未读取到）}"
      echo "  proxy-rebuild(18793) 监听 = $(port_listening $HERMES_PORT && echo 是 || echo 否)" ;;
    cursor)
      echo "Cursor:"
      echo "  当前所有者            = 请在 Cursor GUI (Settings → Models) 查看 OpenAI Base URL"
      echo "  proxy-rebuild(18794) 监听 = $(port_listening $CURSOR_PORT && echo 是 || echo 否)" ;;
    dsh)
      local url; url="$(current_dsh_url 2>/dev/null || true)"
      echo "DSH (profile=${DSH_PROFILE:-desktop}, provider=$DSH_PROVIDER):"
      echo "  当前所有者            = $(detect_owner dsh "$url")"
      echo "  baseURL                = ${url:-（未读取到）}"
      echo "  默认模型(provider|model)= $(dsh_default_model 2>/dev/null || echo '(读不到)')"
      echo "  curator 桥(18795) 监听 = $(port_listening $CURATOR_PORT && echo 是 || echo 否)" ;;
  esac
  # ---- curator 开关状态（所有 agent 共用一行）----
  if [ -f "$SWITCH_STATE" ]; then
    echo "  curator 开关状态       = 已开启（切前：$(last_switch)）"
    echo "  关闭方法               = agent-proxy-switch $1 off"
  else
    echo "  curator 开关状态       = 关（未切过 curator）"
  fi
}

switch_one() {
  local agent="$1" owner="$2"

  # ---------------------------------------------------------------------
  # curator / off —— 2026-10-02 加的「省钱总开关」一对。
  # 放在最前面统一处理，各 agent 的原生 set_* 完全复用，不复制粘贴。
  # ---------------------------------------------------------------------
  case "$owner" in
    curator)
      if ! port_listening $CURATOR_PORT; then
        echo "  [错误] curator 桥(18795)未监听 —— 拒绝写入，避免死链。" >&2
        echo "         桥由 launchd 托管，先起它：" >&2
        echo "         launchctl kickstart -k gui/$(id -u)/com.multi-proxy.token-policy-bridge" >&2
        return 1
      fi
      local prev prev_url prev_model="" prev_prov=""
      case "$agent" in
        codex)  prev_url="$(current_codex_url)";    prev="$(detect_owner codex "$prev_url")" ;;
        hermes) prev_url="$(current_hermes_url)";   prev="$(detect_owner hermes "$prev_url")" ;;
        dsh)    prev_url="$(current_dsh_url 2>/dev/null || true)"; prev="$(detect_owner dsh "$prev_url")"
                # 🔴 dsh 的开关动的是 agent-default-model.provider，所以切前必须记**真实的
                #    provider 名（agnes / curator / ollama…），不能记 detect_owner 的语义标签：
                #    agnes 的原生 baseURL 匹配不上任何 known owner ⇒ detect_owner 返回 direct，
                #    照它回滚就是写 `provider: direct`，而 dsh 里根本没这个 provider，
                #    回滚完 dsh 直接读不到 provider（2026-10-02 实测踩到）。
                local dm_tmp
                dm_tmp="$(dsh_default_model 2>/dev/null || true)"
                prev_prov="${dm_tmp%%|*}"
                prev_model="${dm_tmp##*|}" ;;
        cursor) prev="(Cursor 的 base_url 在 GUI 里，读不到)"; prev_url="";;
      esac
      [ -n "$prev_url" ] && [ "$prev_url" != "$CURATOR_URL" ] || prev_url=""
      record_switch "$agent" "${prev:-unknown}" "$prev_url" "$prev_model" "$prev_prov"
      case "$agent" in
        codex)  set_codex  "$CURATOR_URL" ;;
        hermes) set_hermes "$CURATOR_URL" ;;
        dsh)    set_dsh_default curator "$DSH_CURATOR_MODEL" ;;
        cursor)
          echo "  [半自动] 请在 Cursor GUI 完成切换：Settings → Models → OpenAI Base URL = $CURATOR_URL" ;;
      esac
      echo "  ✅ $agent 已切到 curator（$CURATOR_URL）。关闭时执行：agent-proxy-switch $agent off"
      return 0 ;;
  esac

  # 🔴 各 agent 的原生 owner 分支执行完必须 return 0，否则会一路穿到下面的兜底，
  #    在“明明写成功了”之后又补一句「未知的 owner: x」（2026-10-02 实测：切 codex
  #    到 proxy-rebuild 时 base_url 确实写入了，但命令末尾照样报错，看着像失败）。
  return 0

  case "$agent" in
    codex)
      case "$owner" in
        cc-switch)
          set_codex "$CC_SWITCH_URL"
          echo "  请重启 Codex 使配置生效。" ;;
        proxy-rebuild)
          if ! port_listening $CODEX_PORT; then
            echo "  [错误] proxy-rebuild 的 codex 代理(18790)未监听。可能未安装/未启动。"
            echo "     为避免死链已中止。请先启动 proxy-rebuild，再：agent-proxy-switch codex proxy-rebuild"
            return 1
          fi
          set_codex "$PR_CODEX_URL"
          echo "  请重启 Codex 使配置生效。" ;;
        *) echo "  codex 的 owner 只能是 cc-switch 或 proxy-rebuild" >&2; return 1 ;;
      esac ;;
    hermes)
      case "$owner" in
        proxy-rebuild)
          if ! port_listening $HERMES_PORT; then
            echo "  [错误] proxy-rebuild 的 hermes 代理(18793)未监听。可能未安装/未启动。"
            echo "     为避免死链已中止。请先启动 proxy-rebuild，再：agent-proxy-switch hermes proxy-rebuild"
            return 1
          fi
          set_hermes "$PR_HERMES_URL"
          echo "  请重启 Hermes 使配置生效。" ;;
        direct)
          set_hermes "$DIRECT_HERMES_URL"
          echo "  目标：直连真实服务商。请重启 Hermes 使配置生效。" ;;
        *) echo "  hermes 的 owner 只能是 proxy-rebuild 或 direct" >&2; return 1 ;;
      esac ;;
    cursor)
      case "$owner" in
        proxy-rebuild)
          if ! port_listening $CURSOR_PORT; then
            echo "  [错误] proxy-rebuild 的 cursor 代理(18794)未监听。可能未安装/未启动。"
            echo "     为避免死链已中止。请先启动 proxy-rebuild，再：agent-proxy-switch cursor proxy-rebuild"
            return 1
          fi
          echo "  [半自动] 请手动在 Cursor GUI 完成切换："
          echo "    1) 打开 Cursor → Settings → Models"
          echo "    2) 把 OpenAI Base URL 设为: $PR_CURSOR_URL"
          echo "    3) 确保 proxy-rebuild 已启动（见上，端口 18794 监听中）" ;;
        direct)
          echo "  [半自动] 请手动在 Cursor GUI 完成切换："
          echo "    1) 打开 Cursor → Settings → Models"
          echo "    2) 清空 OpenAI Base URL（恢复 Cursor 默认）" ;;
        *) echo "  cursor 的 owner 只能是 proxy-rebuild 或 direct" >&2; return 1 ;;
      esac ;;
  esac

  # ---- off：回滚到「切 curator 之前」----
  # 🔴 刻意不猜 agent 的原生直连是谁：codex 原生是 api.openai.com、dsh 原生是
  # DeepSeek 官方（且走 device-flow 登录态，不是 baseURL 能表达的）。猜错就是把
  # agent 送到一个没账本、甚至需要新 key 的地方。所以 off = undo 到记录值。
  if [ "$owner" = "off" ] || [ "$owner" = "curator-off" ]; then
    [ -f "$SWITCH_STATE" ] || {
      echo "  [错误] 没有 curator 切换记录（$SWITCH_STATE）。" >&2
      echo "         off 只能回滚到「切 curator 之前」，没有记录就只能手动改回。" >&2
      return 1
    }
    local rec ragent rfrom rurl rmodel rprov
    rec="$(last_switch)" || { echo "  [错误] 状态文件读不出来" >&2; return 1; }
    IFS='|' read -r ragent rfrom rurl rmodel rprov <<< "$rec"
    [ "$ragent" = "$agent" ] || {
      echo "  [错误] 记录里的切换对象是 [$ragent]，不是 [$agent]，拒绝跨 agent 回滚。" >&2
      return 1
    }
    [ -n "$rfrom" ] || { echo "  [错误] 记录里没有『切前 owner』，无法回滚" >&2; return 1; }
    case "$agent" in
      codex)
        if [ "$rfrom" = "curator" ] || [ -z "$rurl" ]; then set_codex "$CURATOR_URL"
        else set_codex "$rurl"; fi ;;
      hermes)
        if [ "$rfrom" = "curator" ] || [ -z "$rurl" ]; then set_hermes "$CURATOR_URL"
        else set_hermes "$rurl"; fi ;;
      dsh)
        # 切 curator 时动的是 agent-default-model，回滚也只动这一处。
        # 🔴 provider 必须取记录里的 rprov（agnes/curator…），不能取 rfrom：
        #    detect_owner 对 agnes 原生 baseURL 返回的是语义标签 direct，
        #    直接写回去 = dsh 里没有的 provider，回滚完 dsh 读不到 provider（2026-10-02 踩过）。
        set_dsh_default "${rprov:-$DSH_PROVIDER}" "${rmodel:-$DSH_CURATOR_MODEL}" ;;
    esac
    rm -f "$SWITCH_STATE"
    echo "  ✅ $agent 已回滚（切 curator 前 = $rfrom）。dsh/codex 若缓存在进程内，重启一次生效。"
    return 0
  fi
  echo "  [错误] 未知的 owner: $owner" >&2; return 1
}

usage() {
  cat <<'EOF'
用法:
  agent-proxy-switch                        # 状态总览（全部 agent）
  agent-proxy-switch <agent>                # 单个 agent 状态
  agent-proxy-switch <agent> <owner>        # 切换代理所有者

  <agent> ∈ codex | hermes | cursor | dsh
  <owner>:
    codex  : cc-switch | proxy-rebuild | curator | off
    hermes : proxy-rebuild | direct    | curator | off
    cursor : proxy-rebuild | direct    | curator | off   (半自动)
    dsh    : direct                    | curator | off

  curator / off 是「省钱总开关」一对：
    agent-proxy-switch codex  curator   # 切到 curator 桥（18795），开始省
    agent-proxy-switch codex  off       # 回滚到切 curator 之前（不是猜直连）
    agent-proxy-switch dsh    curator   # dsh 侧改 cordis.patch.yml 的 provider.baseURL
    agent-proxy-switch dsh    off       # 还原（用切换时记录的旧值）
EOF
}

# ---- 入口 ----
agent="${1:-}"; owner="${2:-}"
if [ -z "$agent" ]; then
  echo "===== 模型代理所有权总览 ====="
  for a in codex hermes cursor dsh; do status_one "$a"; echo; done
  exit 0
fi
case "$agent" in
  codex|hermes|cursor|dsh) ;;
  *) echo "未知 agent: $agent" >&2; usage >&2; exit 1 ;;
esac
if [ -z "$owner" ]; then
  status_one "$agent"
  exit 0
fi

switch_one "$agent" "$owner"
