FROM node:20-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y python3 g++ make && rm -rf /var/lib/apt/lists/*

COPY cursor-proxy/package.json cursor-proxy/package-lock.json* ./
RUN npm install

COPY cursor-proxy/ .
RUN npm run build

FROM node:20-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y python3 lsof g++ make && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/data

COPY --from=builder /app/dist ./dist
COPY cursor-proxy/package.json .
RUN rm -rf node_modules && npm install --omit=dev

ENV PORT=18794

EXPOSE 18794

CMD ["node", "dist/index.js", "start"]
