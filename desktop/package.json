{
  "name": "proxy-manager-desktop",
  "productName": "Proxy Manager",
  "version": "1.0.0",
  "description": "Multi-Proxy Manager 桌面壳：窗口 + 服务生命周期管理",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.xiaota.proxy-manager",
    "productName": "Proxy Manager",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html"
    ],
    "mac": {
      "target": ["dir"],
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
