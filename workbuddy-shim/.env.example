# workbuddy-shim 环境变量配置
# 用法：复制为 .env 并填入实际值（shim 启动时从 .env 读取；也可由 launchd.plist 直接注入）
#   cp .env.example .env
#
# 红线（务必遵守，对应 dsh 插件的 ToS 灰区）：
#   · 只用你【自己】WorkBuddy 账号的 token；
#   · shim 不读桌面端私有存储、不做每日签到 bot（促销刷取，风险高）；
#   · 默认只绑 127.0.0.1；要暴露到网络前必须设 WORKBUDDY_SHIM_AUTH_TOKEN。

# ===== 绑定（默认即可，loopback）=====
# 监听端口（generic-openai-proxy 的 base_url 要指向 http://127.0.0.1:18789/v1）
WORKBUDDY_SHIM_PORT=18789
# 绑定地址：127.0.0.1 = 仅本机；改 0.0.0.0 前务必设下面的 AUTH_TOKEN
WORKBUDDY_SHIM_BINDING=127.0.0.1
# 若把 shim 暴露到网络，必须设这个，否则谁都能用你的 token 打 WorkBuddy
WORKBUDDY_SHIM_AUTH_TOKEN=

# ===== 凭证（必填：你自己的 WorkBuddy 账号 token）=====
# 获取方式见 README「获取 token」一节，或跑 `node token-extract.js` 看指引。
# 最稳：WorkBuddy 桌面端 DevTools → Network → 任意 copilot.tencent.com 请求的
#       Authorization: Bearer xxxx 里的 xxxx。
WORKBUDDY_ACCESS_TOKEN=
# 刷新 token（可选）：填了之后 accessToken 过期时 shim 会 best-effort 自动刷新一次。
WORKBUDDY_REFRESH_TOKEN=

# ===== 账号上下文（可选，按你账号情况填）=====
# 个人免费账号通常留空即可。企业/组织账号可能需要：
WORKBUDDY_UID=
WORKBUDDY_ENTERPRISE_ID=
WORKBUDDY_DOMAIN=
# 区域：留空 = 国内 CN（copilot.tencent.com）；填 workbuddy.ai = 国际版（www.workbuddy.ai）
WORKBUDDY_DOMAIN_REGION=

# ===== 模型 =====
# 客户端侧看到的模型名（即 generic-openai-proxy 里注册的 models 列表，也是 /v1/models 返回的内容）。
# 约定用 wb- 前缀，避免跟真 DeepSeek 的 deepseek-v3.2 撞名。
WORKBUDDY_MODELS=wb-deepseek-v3.2,wb-deepseek-r1,wb-hunyuan-t1,wb-hunyuan-turbo,wb-kimi-k2,wb-glm-4.5,wb-qwen3-max
# 别名映射（可选）：wb-名称 → WorkBuddy 真实模型 id。未配置时默认规则是「去掉 wb- 前缀」。
# 例：WORKBUDDY_MODEL_ALIASES=wb-deepseek-v3.2:deepseek-v3.2,wb-r1:deepseek-r1
WORKBUDDY_MODEL_ALIASES=
# 客户端 UA 用的版本号（一般不用改）
WORKBUDDY_CLIENT_VERSION=
