# Multi-Proxy Manager 环境变量配置
# 使用方法：复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# 端口 (默认: 18792)
PORT=18792

# JWT 签名密钥 — 用于签发和验证登录 Token
# 生产环境务必修改默认值，否则 Token 可被伪造
JWT_SECRET=change-me-to-a-random-string

# 管理面板密码 — 可选
# 如果不设置，首次访问会通过 Web UI 引导设置密码
# 如果设置，将直接使用此密码进行登录验证
MANAGER_PASSWORD=

# CORS 允许的来源 — Manager 前端访问地址
CORS_ORIGIN=http://localhost:18792

# 测试环境（开发时使用）
# NODE_ENV=test

# ---- L2 门控（默认全关：不开就是 403 零副作用，不碰热路径）----
# 用法（不用手动敲环境变量，已经包成 npm script）：
#   npm run start:l2        # 同时开 skill-service + skill-hosts 两个 L2 面
#   npm run start:l2:skill  # 只开 skill-hosts（技能账本 + /skills 页面）
# 或手动：PROXY_L2_SKILL=1 PROXY_L2_SKILLHOSTS=1 node server.js

# 技能服务 CRUD（默认关）→ /api/skill-service
# PROXY_L2_SKILL=1

# 技能账本 / 宿主adapter（默认关）→ /api/skill-hosts + /skills 页面
# PROXY_L2_SKILLHOSTS=1

# skill-service 落盘目录（**留空 = 纯内存**，绝不默认写盘；设了才落 skills.json）
# 对齐 routes/registry.js 的 L2_REGISTRY_DIR 写法
# L2_SKILL_DIR=./data/skill-service

# token-policy 门控（默认关）→ onRequestAssemble 等 5 hook
# PROXY_TOKEN_POLICY=1
