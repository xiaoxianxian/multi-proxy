# Multi-Proxy Manager 环境变量配置
# 使用方法：复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# 端口 (默认: 18792)
PORT=18792

# JWT 签名密钥 — 用于签发和验证登录 Token
# 生产环境务必修改默认值，否则 Token 可被伪造
JWT_SECRET=change-me-to-a-random-string

# 管理面板密码 — 可选
# 如果不设置，首次访问会通过 Web UI 引导设置密码
# 如果设置，将直接使用此密码进行登录验证
MANAGER_PASSWORD=

# CORS 允许的来源 — Manager 前端访问地址
CORS_ORIGIN=http://localhost:18792

# 测试环境（开发时使用）
# NODE_ENV=test

# ---- L2 门控（默认全关：不开就是 403 零副作用，不碰热路径）----
# 用法（不用手动敲环境变量，已经包成 npm script）：
#   npm run start:l2        # 同时开 skill-service + skill-hosts 两个 L2 面
#   npm run start:l2:skill  # 只开 skill-hosts（技能账本 + /skills 页面）
# 或手动：PROXY_L2_SKILL=1 PROXY_L2_SKILLHOSTS=1 node server.js

# 技能服务 CRUD（默认关）→ /api/skill-service
# PROXY_L2_SKILL=1

# 技能账本 / 宿主adapter（默认关）→ /api/skill-hosts + /skills 页面
# PROXY_L2_SKILLHOSTS=1

# skill-service 落盘目录（**留空 = 纯内存**，绝不默认写盘；设了才落 skills.json）
# 对齐 routes/registry.js 的 L2_REGISTRY_DIR 写法
# L2_SKILL_DIR=./data/skill-service

# token-policy 门控（默认关）→ onRequestAssemble 等 5 hook
# PROXY_TOKEN_POLICY=1

# ---- B 类副作用故障处置链路（默认全关：不介入任何既有逻辑）----
# 解决的是「副作用已发出、但不知道成没成」这类故障（区别于「拿不到结果」的重试类故障）。
# 核心规则：没有确定答案的动作，**绝不自动重试**，必须先查源系统对账。
# 详见 /Users/xiaota/Documents/AI项目/agent-infra/methodology/副作用边界与恢复顺序.md
#
# 用法（已包成 npm script，不用手敲环境变量）：
#   npm run start:guard        # 开编排层 + 动作审计写盘
# 或手动：MULTI_PROXY_SIDE_EFFECT_GUARD=1 MULTI_PROXY_ACTION_AUDIT=1 node server.js
#
# 编排层总门控（默认关）→ /api/sessions 的 step / resume
#   关时：与接线前逐字段一致（零行为变更）
#   开时：step 走权限门禁 + 幂等跳过；resume 先对账再续跑（有未终结动作则 409）
# MULTI_PROXY_SIDE_EFFECT_GUARD=1
#
# 动作审计写盘（默认关）→ ~/.multi-proxy-manager/action-audit.log（JSONL，mode 0600）
#   记「谁在什么时候改了什么业务数据」；与 logger.js 的请求日志不是一个靶子，别混着看
#   建议与编排层同时开，否则没有账本可查
# MULTI_PROXY_ACTION_AUDIT=1
#
# 工具权限门禁（curator pack，默认 pass = 不拦）→ 可选 deny / allow 两种模式
#   deny  = 按黑名单拦（下面 DENY 清单里的工具）
#   allow = 只放行白名单（下面 ALLOW 清单里的工具）
# CURATOR_TOOL_GATE_MODE=deny
# CURATOR_TOOL_GATE_DENY=rm,delete
# CURATOR_TOOL_GATE_ALLOW=read,search
# CURATOR_TOOL_GATE_REJECT_MSG=[工具未授权 · 已被工具能力控制面拦截]
#
# 开了之后能用的两个对账端点（只读，不依赖上面的门控开关）：
#   GET  /api/sessions/reconcile/pending      — 崩溃重启后「哪些动作还不知道成没成」
#   POST /api/sessions/reconcile  {"idempotencyKey":"..."}
#        → { decision: "skip" | "retry" | "manual", reason, history }
#        🔴 返回值里永远不会有「unknown → retry」：unknown 一律 manual（先查源系统）
