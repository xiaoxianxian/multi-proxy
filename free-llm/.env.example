# free-llm · 各家免费/路由 key 模板（① 厂商自家 key；② 路由网关 key）
# 本模板（.env.example）可进 git；真实 .env 被 .gitignore，key 不会进 git。
# 用法：cp .env.example ~/.multi-proxy-manager/.env && $EDITOR ~/.multi-proxy-manager/.env 粘贴 key，然后 bash install.sh；
#       或一键 node key-wizard.mjs（自动写 ~/.multi-proxy-manager/.env）。

OPENROUTER_FREE_KEY=      # https://openrouter.ai/keys （选带 :free 的模型）
GROQ_FREE_KEY=            # https://console.groq.com/keys （有日请求/日 token 上限）
SILICONFLOW_FREE_KEY=     # 硅基流动控制台（对部分模型发免费额度）
VERCEL_KEY=               # ② 路由网关：Vercel AI Gateway（api.vercel.ai/gateway，注册送 10 次免费调用）
OPENCODE_KEY=             # ② 路由网关：OpenCode Zen（opencode.ai/zen，免费模型限时·零保留，需账号 key）

# 可选：改默认端口（默认 18799）
# FREE_LL_PORT=18799
