{
  "plugin": "free-llm",
  "display_name": "免费模型聚合（OpenRouter + Groq + 硅基流动 + Vercel + OpenCode Zen + Kilo 匿名池）",
  "version": "0.1.0",
  "engine": "generic-openai-proxy",
  "endpoint": {
    "base_url": "http://127.0.0.1:18799/v1",
    "api_key_required": false,
    "key_hint": "本插件复用 18799，不需额外 token；免费上游的 key 在 live providers.json 里"
  },
  "key_mode": "user-provided-free-keys",
  "key_slots": [
    { "provider": "openrouter",  "env": "OPENROUTER_FREE_KEY",  "console": "https://openrouter.ai/keys" },
    { "provider": "groq",        "env": "GROQ_FREE_KEY",        "console": "https://console.groq.com/keys" },
    { "provider": "siliconflow", "env": "SILICONFLOW_FREE_KEY", "console": "硅基流动控制台" }
  ],
  "providers_seed": "providers.seed.json",
  "free_ids": ["free-llm-openrouter", "free-llm-groq", "free-llm-siliconflow", "free-llm-kilo"],
  "is_free": [
    "thinkingmachines/inkling:free",
    "google/gemma-4-31b-it:free",
    "openai/gpt-oss-120b",
    "openai/gpt-oss-20b",
    "Qwen/Qwen2-7B-Instruct",
    "THUDM/glm-4-9b-chat",
    "kilo-auto/free",
    "nvidia/nemotron-3.5-super-vl:free",
    "reflection/beam-free",
    "stealth/glyph-cluster",
    "recursive/flint-v1.0:free",
    "xingchen-agi/xing4.0-29b-a4b:free",
    "dots-studio/dots-3-note-preview:free",
    "liquid/lfm-2.5-2.6b:free",
    "nvidia/nemotron-3.5-lightning:free",
    "poolside/laguna-s-2.1:free",
    "poolside/laguna-xs-2.1:free",
    "cohere/north-mini-code:free",
    "nvidia/nemotron-3.5-content-safety:free",
    "nvidia/nemotron-3-ultra-550b-a55b:free",
    "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
    "nvidia/nemotron-3-super-120b-a12b:free",
    "openrouter/free"
  ],
  "is_free_note": "三家免费 id 于 2026-10-19 逐家核实：OpenRouter=公开 /v1/models 免鉴权实拉（16 家 :free，随时间轮换，重装前建议重拉）；Groq gpt-oss-120b/20b 各公开源一致免费（llama-3.3-70b 自 2026-08 起有源称转企业版故未列）；硅基流动取官方『免费大语言模型列表』永久免费档。Groq/硅基流动目录会随官方变动，有 key 后以其 /v1/models 为准。",
  "lifecycle": {
    "install": "install.sh",
    "uninstall": "uninstall.sh",
    "selftest": "test/test-e2e.mjs",
    "restart_needed_on_key_change": false
  },
  "disclaimer": [
    "免费模型来自 OpenRouter / Groq / 硅基流动的免费额度，非 multi-proxy 提供。",
    "无 SLA：免费源可随时收紧、涨价、取消，本插件不对其存续担责。",
    "仅限个人自用；商用 / 转售前须逐家核对各家 ToS。",
    "各家免费目录不重叠，429 切换后可能落到另一家不同模型，属预期行为。",
    "卸载只移除 free-llm-* 条目，不动其它 provider、不重启、不删数据。",
    "【匿名源 Kilo】上游可能把你的 prompt / 工具返回内容用于改进服务，敏感代码与私有资料勿走此车道。",
    "【匿名源 Kilo】限约 200 次请求 / 小时 / IP，且无账号、无额度申诉通道；高并发或生产请走自带 key 的源。"
  ],
  "anonymous_sources": [
    { "provider": "kilo", "endpoint": "https://api.kilo.ai/api/gateway", "needs_key": false, "risk": "上游可能记录 prompt 用于改进；限 ~200 次/小时/IP；无 SLA" }
  ]
}
