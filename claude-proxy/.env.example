# Claude Proxy 环境变量配置
# 使用方法：复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# 代理端口 (默认: 18791)
PORT=18791

# ============================================
# 上游模型 API Key — 按需配置，不用的留空即可
# ============================================

# DeepSeek API Key（opus / sonnet 档默认映射目标）
# 申请地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Moonshot/Kimi API Key
# 申请地址: https://platform.moonshot.cn
MOONSHOT_API_KEY=

# Agnes AI API Key（haiku 档默认映射目标）
# 申请地址: https://agnes-ai.com
AGNES_API_KEY=

# ============================================
# 模型别名映射覆盖（可选，不配则用内置默认）
#   内置默认：opus/sonnet → deepseek-v4-pro，haiku → agnes-3.0-flash
# ============================================
# CLAUDE_ALIAS_OPUS=deepseek-v4-pro
# CLAUDE_ALIAS_SONNET=deepseek-v4-pro
# CLAUDE_ALIAS_HAIKU=agnes-3.0-flash
